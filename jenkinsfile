pipeline {
    agent any

 stages {
        stage('clone') {
            steps {
                 git branch: 'main', credentialsId: 'b8e710ac-da54-4a97-90e1-a7b004428bde', url: 'https://github.com/krutikasoshte/Devops77.git'
            }
        }
        stage('compile') {
            steps {
                bat 'javac Hello.java'
            }
        }
        stage('run') {
            steps {
                bat 'java Hello'
            }
        }
    }
}
